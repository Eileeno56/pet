rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isActiveOwner(userId) {
      return hasVerifiedEmail() && isOwner(userId)
        && get(/databases/$(database)/documents/users/$(userId))
          .data.accountStatus == 'active';
    }

    function isActiveCare(userId) {
      return isActiveOwner(userId) || (hasVerifiedEmail()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
        && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active'
        && exists(/databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/careInvitations/$(get(/databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid)).data.invitationId)).data.status == 'accepted');
    }

    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 60
        && name.matches('^[A-Za-zÀ-ÖØ-öø-ÿĀ-ž]+( [A-Za-zÀ-ÖØ-öø-ÿĀ-ž]+)*$');
    }

    function isAdmin() {
      return hasVerifiedEmail()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function canReadUserData(userId) {
      return isOwner(userId) || isAdmin();
    }

    function hasValidUserData(data, userId) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'photoUrl',
          'createdAt',
          'lastActivity',
          'accountStatus'
        ])
        && data.uid == userId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 60
        && data.email is string
        && (data.photoUrl == null || data.photoUrl is string)
        && data.createdAt is timestamp
        && data.lastActivity is timestamp
        && data.accountStatus in ['active', 'disabled'];
    }

    function maxPetAge(species) {
      return {'Perro': 30, 'Gato': 30, 'Conejo': 20, 'Ave': 100,
        'Hámster': 5, 'Tortuga': 200, 'Pez': 100, 'Otro': 250}.get(species, 250);
    }

    function hasValidPetData(data) {
      return data.keys().hasOnly([
          'name',
          'nameKey',
          'species',
          'breed',
          'age',
          'ageMonths',
          'customSpecies',
          'description',
          'photoUrl',
          'createdAt'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 60
        && data.species in [
          'Perro',
          'Gato',
          'Conejo',
          'Ave',
          'Hámster',
          'Tortuga',
          'Pez',
          'Otro'
        ]
        && data.breed is string
        && (data.breed.size() == 0 || data.breed.size() >= 2)
        && data.breed.size() <= 80
        && data.age is int
        && data.age >= 0
        && data.get('ageMonths', 0) is int
        && data.get('ageMonths', 0) >= 0
        && data.get('ageMonths', 0) <= 11
        && data.age * 12 + data.get('ageMonths', 0) <= maxPetAge(data.species) * 12
        && data.get('customSpecies', '') is string
        && data.get('customSpecies', '').size() <= 40
        && (data.species != 'Otro' || data.get('customSpecies', '').size() >= 2)
        && data.description is string
        && data.description.size() <= 500
        && data.photoUrl == null
        && data.createdAt is timestamp;
    }

    function hasPetName(userId, petId, data) {
      return data.nameKey == data.name.lower()
        && getAfter(/databases/$(database)/documents/users/$(userId)/petNames/$(data.nameKey)).data.petIds.hasAny([petId]);
    }

    function releasedName(userId, petId, key) {
      return !existsAfter(/databases/$(database)/documents/users/$(userId)/pets/$(petId))
        || getAfter(/databases/$(database)/documents/users/$(userId)/pets/$(petId)).data.nameKey != key;
    }

    function removedReservation(userId, petId, key) {
      return !existsAfter(/databases/$(database)/documents/users/$(userId)/petNames/$(key))
        || !getAfter(/databases/$(database)/documents/users/$(userId)/petNames/$(key)).data.petIds.hasAny([petId]);
    }

    function hasValidScheduleData(data, scheduleId) {
      return data.keys().hasOnly(['id', 'time', 'active', 'createdAt', 'label', 'foodType', 'notes', 'weekdays'])
        && data.id == scheduleId
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.active is bool
        && data.get('label', '') is string && data.get('label', '').size() <= 40
        && data.get('foodType', 'Alimento') is string && data.get('foodType', 'Alimento').size() >= 1
        && data.get('foodType', 'Alimento').size() <= 60
        && data.get('notes', '') is string && data.get('notes', '').size() <= 300
        && data.get('weekdays', [1,2,3,4,5,6,7]) is list
        && data.get('weekdays', [1,2,3,4,5,6,7]).size() >= 1
        && data.get('weekdays', [1,2,3,4,5,6,7]).size() <= 7
        && data.get('weekdays', [1,2,3,4,5,6,7]).hasOnly([1,2,3,4,5,6,7])
        && data.get('weekdays', [1,2,3,4,5,6,7]).toSet().size() == data.get('weekdays', [1,2,3,4,5,6,7]).size()
        && data.createdAt is timestamp;
    }

    function hasValidHistoryData(data, historyId, userId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'petId',
          'petName',
          'scheduleId',
          'scheduledTime',
          'dateKey',
          'status',
          'fedAt',
          'manual', 'grams', 'food',
          'createdAt'
        ])
        && data.id == historyId
        && data.userId == userId
        && data.petId is string
        && data.petName is string
        && data.petName.size() >= 2
        && data.petName.size() <= 60
        && data.scheduleId is string
        && data.scheduledTime is string
        && data.scheduledTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.dateKey is string
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.get('manual', false) is bool
        && data.get('grams', 0) is number && data.get('grams', 0) >= 0 && data.get('grams', 0) <= 10000
        && data.get('food', '') is string && data.get('food', '').size() <= 80
        && (!data.get('manual', false) || (data.scheduleId == 'manual' && data.status == 'fed' && data.grams > 0))
        && data.status in ['pending', 'fed']
        && (data.fedAt == null || data.fedAt is timestamp)
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && hasValidUserData(request.resource.data, userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountStatus == 'active'
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time;

      allow read: if canReadUserData(userId);

      allow update: if hasValidUserData(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.name == resource.data.name || validName(request.resource.data.name))
        && (
          (isActiveOwner(userId)
            && request.resource.data.accountStatus == resource.data.accountStatus
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'photoUrl', 'lastActivity']))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['accountStatus']))
        );

      allow delete: if isActiveOwner(userId);

      match /caregivers/{memberId} {
        allow read: if hasVerifiedEmail() && (isOwner(userId) || isOwner(memberId));
        allow create: if isActiveOwner(memberId)
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid','email','invitationId','createdAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.acceptedBy == memberId
          && getAfter(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.ownerId == userId
          && getAfter(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.email == request.resource.data.email;
        allow delete: if isActiveOwner(userId) || (hasVerifiedEmail() && isOwner(memberId));
      }
      match /careSpaces/{ownerId} {
        allow read, delete: if hasVerifiedEmail() && isOwner(userId);
        allow create, update: if isActiveOwner(userId)
          && request.resource.data.keys().hasOnly(['ownerId','ownerName','invitationId'])
          && request.resource.data.ownerId == ownerId
          && getAfter(/databases/$(database)/documents/users/$(ownerId)/caregivers/$(userId)).data.invitationId == request.resource.data.invitationId
          && request.resource.data.ownerName == get(/databases/$(database)/documents/careInvitations/$(request.resource.data.invitationId)).data.ownerName;
      }

      match /petNames/{key} {
        allow read: if isActiveCare(userId) || isAdmin();
        allow create: if isActiveCare(userId)
          && request.resource.data.keys().hasOnly(['petIds'])
          && request.resource.data.petIds is list
          && request.resource.data.petIds.size() == 1
          && getAfter(/databases/$(database)/documents/users/$(userId)/pets/$(request.resource.data.petIds[0])).data.nameKey == key
          && getAfter(/databases/$(database)/documents/users/$(userId)/pets/$(request.resource.data.petIds[0])).data.name.lower() == key;
        // Solo se permite retirar una reserva. Los duplicados anteriores se conservan hasta renombrarlos.
        allow update: if isActiveCare(userId)
          && request.resource.data.keys().hasOnly(['petIds'])
          && request.resource.data.petIds is list
          && request.resource.data.petIds.size() > 0
          && request.resource.data.petIds.size() == resource.data.petIds.size() - 1
          && request.resource.data.petIds.toSet().size() == request.resource.data.petIds.size()
          && request.resource.data.petIds.hasOnly(resource.data.petIds)
          && releasedName(userId, resource.data.petIds.removeAll(request.resource.data.petIds)[0], key);
        allow delete: if isActiveCare(userId) && resource.data.petIds.size() == 1
          && releasedName(userId, resource.data.petIds[0], key);
      }

      match /pets/{petId} {
        allow read: if isActiveCare(userId) || isAdmin();

        allow create: if isActiveCare(userId)
          && hasValidPetData(request.resource.data)
          && validName(request.resource.data.name)
          && hasPetName(userId, petId, request.resource.data)
          && getAfter(/databases/$(database)/documents/users/$(userId)/petNames/$(request.resource.data.nameKey)).data.petIds == [petId]
          && request.resource.data.createdAt == request.time;

        allow update: if isActiveCare(userId)
          && hasValidPetData(request.resource.data)
          && hasPetName(userId, petId, request.resource.data)
          && (request.resource.data.nameKey == resource.data.nameKey
            || removedReservation(userId, petId, resource.data.nameKey))
          && (request.resource.data.name == resource.data.name || validName(request.resource.data.name))
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name',
              'nameKey',
              'species',
              'breed',
              'age',
              'ageMonths',
              'customSpecies',
              'description',
              'photoUrl'
            ]);

        allow delete: if isActiveCare(userId)
          && removedReservation(userId, petId, resource.data.nameKey);

        match /carePlan/{planId} {
          allow read: if isActiveCare(userId) || isAdmin();
          allow create, update: if planId == 'diet' && isActiveCare(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/pets/$(petId))
            && request.resource.data.keys().hasOnly(['dailyGrams', 'weightKg', 'mealsPerDay', 'food', 'notes'])
            && request.resource.data.dailyGrams is number && request.resource.data.dailyGrams >= 0 && request.resource.data.dailyGrams <= 10000
            && request.resource.data.weightKg is number && request.resource.data.weightKg >= 0 && request.resource.data.weightKg <= 1000
            && request.resource.data.mealsPerDay is int && request.resource.data.mealsPerDay >= 1 && request.resource.data.mealsPerDay <= 12
            && request.resource.data.food is string && request.resource.data.food.size() <= 80
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 500;
          allow delete: if isActiveCare(userId);
        }
        match /medicalRecords/{recordId} {
          allow read: if isActiveCare(userId) || isAdmin();
          allow create, update: if isActiveCare(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/pets/$(petId))
            && request.resource.data.keys().hasOnly(['title','kind','date','notes','nextDate'])
            && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 80
            && request.resource.data.kind in ['Consulta','Vacuna','Desparasitación','Tratamiento','Otro']
            && request.resource.data.date is timestamp
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
            && (request.resource.data.nextDate == null || request.resource.data.nextDate is timestamp);
          allow delete: if isActiveCare(userId);
        }

        match /feedingSchedules/{scheduleId} {
          allow read: if isActiveCare(userId) || isAdmin();

          allow create: if isActiveCare(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/pets/$(petId))
            && hasValidScheduleData(request.resource.data, scheduleId)
            && request.resource.data.createdAt == request.time;

          allow update: if isActiveCare(userId)
            && hasValidScheduleData(request.resource.data, scheduleId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['time', 'active', 'label', 'foodType', 'notes', 'weekdays']);

          allow delete: if isActiveCare(userId);
        }
      }

      match /feedingHistory/{historyId} {
        allow read: if isActiveCare(userId) || isAdmin();

        allow create: if isActiveCare(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/pets/$(request.resource.data.petId))
          && (request.resource.data.get('manual', false) || exists(/databases/$(database)/documents/users/$(userId)/pets/$(request.resource.data.petId)/feedingSchedules/$(request.resource.data.scheduleId)))
          && hasValidHistoryData(request.resource.data, historyId, userId)
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.status == 'pending'
              && request.resource.data.fedAt == null)
            || (request.resource.data.status == 'fed'
              && request.resource.data.fedAt == request.time)
          );

        allow update: if isActiveCare(userId)
          && hasValidHistoryData(request.resource.data, historyId, userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.petId == resource.data.petId
          && request.resource.data.petName == resource.data.petName
          && request.resource.data.scheduleId == resource.data.scheduleId
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('manual', false) == resource.data.get('manual', false)
          && (
            (resource.data.status == 'pending'
              && resource.data.fedAt == null
              && request.resource.data.status == 'pending'
              && request.resource.data.fedAt == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['scheduledTime']))
            || (resource.data.status == 'pending'
              && resource.data.fedAt == null
              && request.resource.data.status == 'fed'
              && request.resource.data.fedAt == request.time
              && request.resource.data.scheduledTime == resource.data.scheduledTime
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'fedAt', 'grams', 'food']))
          );

        allow delete: if isActiveCare(userId);
      }
    }

    match /careInvitations/{invitationId} {
      function recipient() {
        return request.auth != null && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email.lower();
      }
      allow read: if hasVerifiedEmail() && (isOwner(resource.data.ownerId) || recipient());
      allow create: if isActiveOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId','ownerName','email','status','acceptedBy','createdAt'])
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() >= 1 && request.resource.data.ownerName.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.status == 'pending' && request.resource.data.acceptedBy == null
        && request.resource.data.createdAt == request.time;
      allow update: if request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.email == resource.data.email
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.createdAt == resource.data.createdAt
        && ((isActiveOwner(resource.data.ownerId)
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (recipient() && isActiveOwner(request.auth.uid) && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy'])
          && getAfter(/databases/$(database)/documents/users/$(resource.data.ownerId)/caregivers/$(request.auth.uid)).data.invitationId == invitationId));
    }

    // Explicit recursive matches allow secure collection-group dashboards.
    match /{path=**}/pets/{petId} {
      allow read: if isAdmin();
    }

    match /{path=**}/feedingSchedules/{scheduleId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
